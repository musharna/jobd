[Unit]
Description=jobd worker — polls broker, runs assigned jobs
After=network-online.target

[Service]
Type=simple
Environment="JOBD_URL=http://10.0.0.10:8765"
Environment="JOBD_WORKER_HOST=desktop"
Environment="PATH=~/.local/bin:/usr/local/cuda-12.8/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=~/jobd-worker/.venv/bin/python ~/jobd-worker/job_worker.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
